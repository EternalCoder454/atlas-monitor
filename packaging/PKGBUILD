# Maintainer: EternalCoder454 <77252745+EternalCoder454@users.noreply.github.com>
#
# Arch package for Atlas Monitor (minimal) — the monitor with no AI assistant.
#
#   makepkg -si                build and install with pacman
#   pacman -R atlas-monitor-minimal   remove it again
#
# This tracks the `minimal` branch rather than a release tag, because minimal
# has no releases of its own yet: the version is derived from the last tag it
# descends from plus the commit count, which is what a git PKGBUILD normally
# does. Point `source` at a tag instead once one is cut.
#
# It conflicts with the full atlas-monitor package on purpose — both install the
# same binary, desktop entry and icons.
#
# Updates come from pacman, not from the app: the in-app updater needs a source
# checkout to pull and rebuild, and a packaged install has none. It notices that
# on its own and says so rather than half-working.

_pkgname=atlas-monitor
pkgname=atlas-monitor-minimal
pkgver=0.8.3
pkgrel=1
pkgdesc="Lightweight system monitor — CPU, memory, disk, network, GPU, processes and services (no AI assistant)"
arch=('x86_64' 'aarch64')
url="https://github.com/EternalCoder454/atlas-monitor"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2')
makedepends=('go>=1.24' 'gcc' 'pkgconf' 'git')
checkdepends=('desktop-file-utils')
optdepends=('hwdata: names the detected GPU instead of showing its PCI id')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git#branch=minimal")
sha256sums=('SKIP')

# Atlas's own symbolic icons. All atlas-prefixed on purpose: icon lookup falls
# back to hicolor last, so a generic name here would lose to whatever icon theme
# is installed and never be used. Keep in step with ICONS in the Makefile —
# TestPackagingListsAgree checks that every installer agrees.
_icons=(cpu memory disk gpu network wifi battery apps services settings
        update trash reset menu warning)

pkgver() {
    cd "$_pkgname"
    git describe --long --tags --abbrev=7 2>/dev/null \
        | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "0.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$_pkgname"

    # cgo is not optional here: the GTK4 bindings are cgo, and so is the
    # malloc_trim call the memory page uses.
    export CGO_ENABLED=1
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"

    go build -o "$_pkgname" .
}

check() {
    cd "$_pkgname"
    # The test suites read the live /proc and /sys of the machine they run on,
    # which a clean build chroot does not have in full, so they are not run
    # here. The desktop entry is checked because package() generates it.
    desktop-file-validate assets/com.atlas.Monitor.desktop
}

package() {
    cd "$_pkgname"

    install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 assets/style.css "$pkgdir/usr/share/$_pkgname/style.css"
    install -Dm644 assets/icon.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.atlas.Monitor.svg"

    local icon
    for icon in "${_icons[@]}"; do
        install -Dm644 "assets/icons/atlas-$icon-symbolic.svg" \
            "$pkgdir/usr/share/icons/hicolor/scalable/actions/atlas-$icon-symbolic.svg"
    done

    # The desktop file carries a placeholder for wherever the binary landed.
    install -d "$pkgdir/usr/share/applications"
    sed 's|@BIN@|/usr/bin/'"$_pkgname"'|g' assets/com.atlas.Monitor.desktop \
        > "$pkgdir/usr/share/applications/com.atlas.Monitor.desktop"
    chmod 644 "$pkgdir/usr/share/applications/com.atlas.Monitor.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
